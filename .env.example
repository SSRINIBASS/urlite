# PostgreSQL
POSTGRES_USER=urlite
POSTGRES_PASSWORD=change_me_before_running
POSTGRES_DB=urlite

# Connections used by the backend and worker containers
DATABASE_URL=postgres://urlite:change_me_before_running@db:5432/urlite
REDIS_URL=redis://redis:6379

# Optional Cloudflare Tunnel. Enable with:
# docker compose --profile tunnel up -d
# Keep the real token in .env; never commit credentials.
TUNNEL_TOKEN=replace_with_your_cloudflare_tunnel_token
